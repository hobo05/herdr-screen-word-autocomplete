#!/usr/bin/env bash
# screen-word: pick a word from a herdr pane's recent output with fzf and insert it.
# Kept to bash 3.2 and BSD/GNU-common tools so it runs unchanged on macOS and Linux.
set -euo pipefail

VERSION="0.7.0"

usage() {
  cat <<'EOF'
Usage: screen-word <command> [options]

Commands:
  setup [--key K]       Add a popup keybinding (default cmd+; on macOS, alt+; elsewhere)
                        to herdr's config.toml and reload it.
  uninstall             Remove that keybinding. Run it before brew uninstall.
  doctor                Check that the keybinding still points at an installed screen-word.
  popup                 Pick a word from the pane under a herdr popup and type it into that pane.
                        The keybinding runs this.
  pick [--pane ID]      Pick a word with fzf and print it.
  words [--pane ID]     Print the candidate words, newest first.
  words --stdin         Read the text from stdin instead of a pane.

Options:
  --lines N             Read the last N lines of output, including scrollback, instead of only
                        what is visible in the pane.
  -h, --help            Show this help.
  -V, --version         Show the version.

The pane defaults to $HERDR_ACTIVE_PANE_ID, then $HERDR_PANE_ID.
EOF
}

die() {
  echo "screen-word: $*" >&2
  exit 1
}

# macOS keyboards have Option, not Alt, and terminals compose Option+; into "…" unless
# configured to send Alt. Cmd+; is unbound in Ghostty, iTerm2 and Terminal.app, so it is
# the default there. Elsewhere there is no Cmd, and Alt+; reaches herdr as ESC+;.
default_key() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) printf '%s\n' 'cmd+;' ;;
    *) printf '%s\n' 'alt+;' ;;
  esac
}

resolve_pane() {
  local pane="${1:-${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}}"
  [ -n "$pane" ] || die "no herdr pane: run inside herdr or pass --pane ID"
  printf '%s\n' "$pane"
}

# Reads what is visible in the pane, or the last N lines including scrollback when N is given.
read_pane() {
  command -v herdr >/dev/null 2>&1 || die "herdr is not on PATH"
  if [ -n "$2" ]; then
    herdr pane read "$1" --source recent-unwrapped --lines "$2"
  else
    herdr pane read "$1" --source visible
  fi
}

# Splits text into words, trims surrounding quotes, brackets and trailing punctuation,
# and prints each word of 3+ characters once, newest first.
extract_words() {
  awk '
    BEGIN { lead = "\"'\''`([{<"; trail = "\"'\''`)]}>,;:.!?" }
    { lines[NR] = $0 }
    END {
      for (i = NR; i > 0; i--) {
        n = split(lines[i], parts, /[ \t\r]+/)
        for (j = n; j > 0; j--) {
          w = parts[j]
          while (w != "" && index(lead, substr(w, 1, 1))) w = substr(w, 2)
          while (w != "" && index(trail, substr(w, length(w), 1))) w = substr(w, 1, length(w) - 1)
          if (length(w) > 2 && !(w in seen)) { seen[w] = 1; print w }
        }
      }
    }'
}

choose() {
  command -v fzf >/dev/null 2>&1 || die "fzf is not on PATH"
  fzf --prompt 'screen> ' "$@"
}

parse_common() {
  PANE=""
  LINES_TO_READ=""
  STDIN=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pane) [ $# -ge 2 ] || die "--pane needs a value"; PANE="$2"; shift 2 ;;
      --lines) [ $# -ge 2 ] || die "--lines needs a value"; LINES_TO_READ="$2"; shift 2 ;;
      --stdin) STDIN=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  case "$LINES_TO_READ" in *[!0-9]*) die "--lines must be a number" ;; esac
}

source_text() {
  if [ "$STDIN" = 1 ]; then
    cat
  else
    read_pane "$(resolve_pane "$PANE")" "$LINES_TO_READ"
  fi
}

cmd_words() {
  parse_common "$@"
  source_text | extract_words
}

cmd_pick() {
  parse_common "$@"
  source_text | extract_words | choose --height 40%
}

cmd_popup() {
  parse_common "$@"
  local pane word
  pane="$(resolve_pane "${PANE:-${HERDR_ACTIVE_PANE_ID:-}}")"
  word="$(read_pane "$pane" "$LINES_TO_READ" | extract_words | choose)" || exit 0
  [ -n "$word" ] && herdr pane send-text "$pane" "$word" >/dev/null
}

herdr_config_path() {
  printf '%s\n' "${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"
}

reload_herdr() {
  if command -v herdr >/dev/null 2>&1 && herdr config check >/dev/null 2>&1; then
    herdr server reload-config >/dev/null 2>&1 && echo "Reloaded the running herdr server." || true
  fi
}

cmd_setup() {
  local key config self
  key="$(default_key)"
  [ "${1:-}" != "herdr" ] || shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --key) [ $# -ge 2 ] || die "--key needs a value"; key="$2"; shift 2 ;;
      *) die "usage: screen-word setup [--key KEY]" ;;
    esac
  done
  config="$(herdr_config_path)"
  # The path as invoked, not the symlink target, so a brew upgrade (new Cellar dir) keeps the binding working.
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  if [ -f "$config" ] && grep -q 'screen-word' "$config"; then
    echo "screen-word is already bound in $config; edit that block to change it."
    return 0
  fi
  mkdir -p "$(dirname "$config")"
  cat >>"$config" <<EOF

# >>> screen-word >>>
[[keys.command]]
key = "$key"
type = "popup"
command = "$self popup"
description = "insert a word from this pane's output"
width = "60%"
height = "50%"
# <<< screen-word <<<
EOF
  echo "Added $key to $config"
  reload_herdr
}

# Rewrites a file in place through its path, so a symlinked config keeps pointing at its target.
# Leaves the file alone and returns 1 when the filter changed nothing.
rewrite_file() {
  local file="$1" tmp
  shift
  tmp="$(mktemp)"
  "$@" <"$file" >"$tmp"
  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  cat "$tmp" >"$file"
  rm -f "$tmp"
}

# Drops marked screen-word blocks and, for configs written by older versions, any
# [[keys.command]] table that mentions screen-word, with the blank lines before it.
strip_herdr_block() {
  awk '
    /^[ \t]*# >>> screen-word >>>[ \t]*$/ { in_block = 1; pending = ""; next }
    in_block {
      if ($0 ~ /^[ \t]*# <<< screen-word <<<[ \t]*$/) in_block = 0
      next
    }
    /^[ \t]*$/ { pending = pending $0 "\n"; next }
    { printf "%s%s\n", pending, $0; pending = "" }
    END { if (!in_block) printf "%s", pending }' | awk '
    function flush() {
      if (!(is_cmd && cur ~ /screen-word/)) printf "%s%s", lead, cur
    }
    /^[ \t]*\[/ {
      flush()
      lead = gap; gap = ""; cur = $0 "\n"
      is_cmd = ($0 ~ /^[ \t]*\[\[keys\.command\]\]/)
      next
    }
    /^[ \t]*$/ { gap = gap $0 "\n"; next }
    { cur = cur gap $0 "\n"; gap = "" }
    END { cur = cur gap; flush() }'
}

cmd_uninstall() {
  [ "${1:-}" != "herdr" ] || shift
  [ $# -eq 0 ] || die "usage: screen-word uninstall"
  local config
  config="$(herdr_config_path)"
  if [ ! -f "$config" ] || ! rewrite_file "$config" strip_herdr_block; then
    echo "No screen-word binding in $config."
    return 0
  fi
  echo "Removed the screen-word binding from $config"
  reload_herdr
}

# Prints "key<TAB>command" for every [[keys.command]] table that mentions screen-word.
binding_report() {
  awk '
    function flush() {
      if (in_cmd && mentions) printf "%s\t%s\n", key, cmdline
    }
    function value(line,   s) {
      s = line
      sub(/^[^=]*=[ \t]*/, "", s)
      if (s ~ /^"/) { sub(/^"/, "", s); sub(/"[ \t]*$/, "", s) }
      return s
    }
    /^[ \t]*\[/ {
      flush()
      in_cmd = ($0 ~ /^[ \t]*\[\[keys\.command\]\]/)
      mentions = 0
      key = ""
      cmdline = ""
      next
    }
    in_cmd {
      if ($0 ~ /^[ \t]*key[ \t]*=/) key = value($0)
      else if ($0 ~ /^[ \t]*command[ \t]*=/) cmdline = value($0)
      if ($0 ~ /screen-word/) mentions = 1
    }
    END { flush() }'
}

binding_command_exists() {
  case "$1" in
    /*) [ -x "$1" ] ;;
    *) command -v "$1" >/dev/null 2>&1 ;;
  esac
}

cmd_doctor() {
  [ $# -eq 0 ] || die "usage: screen-word doctor"
  local config report count=0 problems=0 path
  config="$(herdr_config_path)"
  echo "herdr config: $config"
  if [ ! -f "$config" ]; then
    echo "No herdr config, so nothing to check."
    return 0
  fi
  report="$(binding_report <"$config")"
  if [ -z "$report" ]; then
    echo "No screen-word binding."
    return 0
  fi
  while IFS=$'\t' read -r key cmdline; do
    count=$((count + 1))
    printf 'Binding: key = "%s", command = "%s"\n' "$key" "$cmdline"
    path="${cmdline%% *}"
    if [ -z "$path" ] || ! binding_command_exists "$path"; then
      printf '  missing: %s\n' "${path:-<empty command>}"
      problems=$((problems + 1))
    fi
  done <<EOF
$report
EOF
  if [ "$count" -gt 1 ]; then
    printf '%d screen-word bindings found; herdr needs only one. Run screen-word uninstall, then screen-word setup.\n' "$count"
    problems=$((problems + 1))
  fi
  if [ "$problems" -gt 0 ]; then
    echo "Run screen-word uninstall to remove the binding, or reinstall screen-word to restore it."
    return 1
  fi
  echo "The binding is healthy."
  return 0
}

main() {
  [ $# -gt 0 ] || { usage; exit 1; }
  local cmd="$1"
  shift
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    doctor) cmd_doctor "$@" ;;
    popup) cmd_popup "$@" ;;
    pick) cmd_pick "$@" ;;
    words) cmd_words "$@" ;;
    -h | --help | help) usage ;;
    -V | --version) echo "screen-word $VERSION" ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
