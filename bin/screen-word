#!/usr/bin/env bash
# screen-word: install the herdr-app mod that picks a word from a terminal's output and inserts it.
# Kept to bash 3.2 and BSD/GNU-common tools so it runs unchanged on macOS and Linux.
set -euo pipefail

VERSION="1.0.1"
MOD_NAME="screen-word"
ACTION="mod.open:$MOD_NAME"

usage() {
  cat <<'EOF'
Usage: screen-word <command> [options]

Commands:
  setup [--key K]       Link the herdr-app mod and bind it in keys.json
                        (default cmd-; on macOS, alt-; elsewhere).
  uninstall             Remove the binding and the mod link. Run it before brew uninstall.
  doctor                Check the binding, the mod and the tools it needs.

Options:
  -h, --help            Show this help.
  -V, --version         Show the version.

herdr-app's folder is $HERDR_APP_HOME, else ~/.config/herdr-app.
EOF
}

die() {
  echo "screen-word: $*" >&2
  exit 1
}

default_key() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) printf '%s\n' 'cmd-;' ;;
    *) printf '%s\n' 'alt-;' ;;
  esac
}

normalize_key() {
  printf '%s\n' "$1" | sed 's/+\([^+]\)/-\1/g'
}

app_home() {
  printf '%s\n' "${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
}

keys_file() {
  printf '%s/keys.json\n' "$(app_home)"
}

mod_link() {
  printf '%s/mods/%s\n' "$(app_home)" "$MOD_NAME"
}

legacy_herdr_config() {
  printf '%s\n' "${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"
}

script_dir() {
  cd "$(dirname "$0")" && pwd
}

mod_source() {
  local root dir
  root="$(dirname "$(script_dir)")"
  for dir in "$root/share/screen-word-autocomplete/mod" "$root/mod"; do
    if [ -f "$dir/main.js" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
  done
  return 1
}

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is not on PATH"
}

rewrite_file() {
  local file="$1" tmp
  shift
  tmp="$(mktemp)"
  if ! "$@" <"$file" >"$tmp"; then
    rm -f "$tmp"
    die "could not update $file"
  fi
  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  cat "$tmp" >"$file"
  rm -f "$tmp"
}

bound_keys() {
  jq -r --arg action "$ACTION" \
    'to_entries[] | select(.value | type == "object") | .key as $section
     | .value | to_entries[] | select(.value == $action) | "\($section)\t\(.key)"' "$1"
}

key_owner() {
  jq -r --arg key "$2" \
    '[.terminal[$key], .global[$key]] | map(select(. != null)) | first // empty
     | if type == "string" then . else tojson end' "$1"
}

add_binding() {
  jq --indent 2 --arg key "$1" --arg action "$ACTION" '.terminal = ((.terminal // {}) + {($key): $action})'
}

drop_bindings() {
  jq --indent 2 --arg action "$ACTION" \
    'with_entries(if (.value | type) == "object"
                  then .value |= with_entries(select(.value != $action)) else . end)'
}

strip_legacy_herdr_block() {
  awk '
    /^[ \t]*# >>> screen-word >>>[ \t]*$/ { in_block = 1; pending = ""; next }
    in_block {
      if ($0 ~ /^[ \t]*# <<< screen-word <<<[ \t]*$/) in_block = 0
      next
    }
    /^[ \t]*$/ { pending = pending $0 "\n"; next }
    { printf "%s%s\n", pending, $0; pending = "" }
    END { if (!in_block) printf "%s", pending }' | awk '
    function flush() {
      if (!(is_cmd && cur ~ /screen-word/)) printf "%s%s", lead, cur
    }
    /^[ \t]*\[/ {
      flush()
      lead = gap; gap = ""; cur = $0 "\n"
      is_cmd = ($0 ~ /^[ \t]*\[\[keys\.command\]\]/)
      next
    }
    /^[ \t]*$/ { gap = gap $0 "\n"; next }
    { cur = cur gap $0 "\n"; gap = "" }
    END { cur = cur gap; flush() }'
}

remove_legacy_herdr_binding() {
  local config
  config="$(legacy_herdr_config)"
  if [ -f "$config" ] && rewrite_file "$config" strip_legacy_herdr_block; then
    echo "Removed the old herdr TUI binding from $config"
  fi
}

link_mod() {
  local source link
  source="$(mod_source)" || die "cannot find the mod next to $0"
  link="$(mod_link)"
  if [ -L "$link" ]; then
    rm -f "$link"
  elif [ -e "$link" ]; then
    die "$link already exists and is not a link; move it away and run setup again"
  fi
  mkdir -p "$(dirname "$link")"
  ln -s "$source" "$link"
  echo "Linked $link -> $source"
}

cmd_setup() {
  local key keys bound owner
  key="$(default_key)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --key) [ $# -ge 2 ] || die "--key needs a value"; key="$2"; shift 2 ;;
      *) die "usage: screen-word setup [--key KEY]" ;;
    esac
  done
  key="$(normalize_key "$key")"
  require_jq
  keys="$(keys_file)"
  [ -f "$keys" ] || die "no $keys: start herdr-app once, then run setup again"

  bound="$(bound_keys "$keys")"
  if [ -z "$bound" ]; then
    owner="$(key_owner "$keys" "$key")"
    [ -z "$owner" ] || die "$key is already bound to $owner in $keys; pick another with --key"
  fi

  link_mod
  if [ -n "$bound" ]; then
    echo "screen-word is already bound in $keys (${bound//$'\t'/ }); edit that entry to change it."
  else
    rewrite_file "$keys" add_binding "$key" || true
    echo "Bound $key to $ACTION in $keys"
  fi
  remove_legacy_herdr_binding
}

cmd_uninstall() {
  [ $# -eq 0 ] || die "usage: screen-word uninstall"
  local keys link
  keys="$(keys_file)"
  link="$(mod_link)"
  if [ -f "$keys" ]; then
    require_jq
    if rewrite_file "$keys" drop_bindings; then
      echo "Removed the screen-word binding from $keys"
    else
      echo "No screen-word binding in $keys."
    fi
  fi
  if [ -L "$link" ]; then
    rm -f "$link"
    echo "Removed $link"
  elif [ -e "$link" ]; then
    echo "Left $link in place: it is not the link setup made."
  fi
  remove_legacy_herdr_binding
}

clipboard_tool() {
  local tool
  for tool in pbcopy wl-copy xclip xsel; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '%s\n' "$tool"
      return 0
    fi
  done
  return 1
}

cmd_doctor() {
  [ $# -eq 0 ] || die "usage: screen-word doctor"
  local keys link problems=0 bound count tool output
  keys="$(keys_file)"
  link="$(mod_link)"
  echo "herdr-app folder: $(app_home)"

  if [ ! -f "$keys" ]; then
    echo "  missing: $keys (start herdr-app once)"
    problems=$((problems + 1))
  elif ! command -v jq >/dev/null 2>&1; then
    echo "  missing: jq, needed to read $keys"
    problems=$((problems + 1))
  else
    bound="$(bound_keys "$keys")"
    count=0
    [ -z "$bound" ] || count="$(printf '%s\n' "$bound" | wc -l | tr -d ' ')"
    if [ "$count" -eq 0 ]; then
      echo "  no binding: run screen-word setup"
      problems=$((problems + 1))
    else
      printf '%s\n' "$bound" | while IFS=$'\t' read -r section key; do
        printf 'Binding: "%s" in %s\n' "$key" "$section"
      done
      if [ "$count" -gt 1 ]; then
        echo "  $count bindings found; one is enough"
        problems=$((problems + 1))
      fi
    fi
  fi
  if [ -f "$(app_home)/keys.error" ]; then
    echo "  herdr-app rejected keys.json: $(cat "$(app_home)/keys.error")"
    problems=$((problems + 1))
  fi

  if [ ! -f "$link/main.js" ]; then
    echo "  missing: the mod at $link"
    problems=$((problems + 1))
  else
    echo "Mod: $link -> $(cd "$link" && pwd -P)"
    if command -v herdr-app >/dev/null 2>&1; then
      if ! output="$(herdr-app check "$link" 2>&1)"; then
        echo "  herdr-app check failed: $output"
        problems=$((problems + 1))
      fi
    fi
  fi

  if ! command -v hc >/dev/null 2>&1; then
    echo "  missing: hc (herdr-core), which reads the terminal"
    problems=$((problems + 1))
  fi
  if tool="$(clipboard_tool)"; then
    echo "Clipboard: $tool"
  else
    echo "  missing: a clipboard tool (wl-clipboard, xclip or xsel)"
    problems=$((problems + 1))
  fi

  if [ -f "$(legacy_herdr_config)" ] && grep -q 'screen-word' "$(legacy_herdr_config)"; then
    echo "  old herdr TUI binding in $(legacy_herdr_config): run screen-word setup or uninstall to remove it"
    problems=$((problems + 1))
  fi

  if [ "$problems" -gt 0 ]; then
    return 1
  fi
  echo "Everything is in place."
}

main() {
  [ $# -gt 0 ] || { usage; exit 1; }
  local cmd="$1"
  shift
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -h | --help | help) usage ;;
    -V | --version) echo "screen-word $VERSION" ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
